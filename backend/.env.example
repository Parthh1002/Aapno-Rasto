# ─── PostgreSQL (Neon.tech) ───────────────────────────────────────────────────
# Get this from neon.tech → Your Project → Connection String
DATABASE_URL=postgresql://username:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─── JWT Auth Secret ──────────────────────────────────────────────────────────
# Run this in terminal to generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-here-change-this

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
